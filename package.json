{
  "name": "anodex",
  "version": "0.4.5",
  "private": true,
  "description": "Anodex \u2014 a local-first AI assistant for coding help and general chat.",
  "author": "Anodex",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "protocol": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs --check",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "dist": "npm run prepare:vision && npm run prepare:desktop-control && npm run notices && electron-vite build && node scripts/package-app.mjs",
    "dist:payload": "electron-builder --win nsis --publish never",
    "ship": "node scripts/ship.mjs",
    "check:attribution": "node scripts/check-attribution.mjs",
    "release:keygen": "node scripts/generate-release-key.mjs",
    "release:sign": "node scripts/sign-release.mjs",
    "release:finish": "node scripts/finish-release.mjs",
    "prepare:vision": "node scripts/prepare-llama-server.mjs",
    "prepare:desktop-control": "node scripts/prepare-windows-control.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate:installer-art": "node scripts/generate-installer-art.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{mjs,js,json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "imapflow": {
      "nodemailer": "^9.1.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "imapflow": "^1.5.0",
    "immer": "^10.1.1",
    "mailparser": "^3.9.23",
    "node-llama-cpp": "^3.4.0",
    "nodemailer": "^9.1.1",
    "openai": "^6.46.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "undici": "^6.27.0",
    "use-sync-external-store": "^1.6.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.6",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^15.5.2",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
